{
  "version": 2,
  "builds": [
    {
      "src": "src/api/*",
      "use": "@vercel/nextjs"
    }
  ],
  "functions": {
    "src/api/*": {
      "runtime": "nodejs20"
    }
  },
  "routes": {
    "/api/*": "src/api/index.ts",
    "/": "/index.html",
    "/phone": "/phone",
    "/tree": "/tree"
  }
}