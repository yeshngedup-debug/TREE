{
  "version": 2,
  "builds": [
    {
      "src": "src/api/*",
      "use": "@vercel/nextjs"
    }
  ],
  "routes": [
    {
      "src": "/api/*",
      "dest": "src/api/index.ts"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/phone",
      "dest": "/phone"
    },
    {
      "src": "/tree",
      "dest": "/tree"
    }
  ],
  "functions": {
    "src/api/*": {
      "runtime": "nodejs20"
    }
  }
}