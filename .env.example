# ---------------------------------------------------------------------------
# BI Tree (Bhutanese Idea Tree) — environment template
# Copy to .env.local (or .env) and fill in values. Never commit secrets.
# ---------------------------------------------------------------------------

# Database
# Production/Vercel: hosted PostgreSQL (Neon), e.g.
#   DATABASE_URL=postgresql://user:password@host:5432/dbname
# Local development/harness only: SQLite file (NOT for Vercel — ephemeral disk)
#   DATABASE_PATH=data/living-tree.sqlite
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Public URL (safe to expose to the browser)
# Leave blank to derive QR/share links from the browser address.
# On Vercel set this to your production domain.
NEXT_PUBLIC_APP_URL=

# Agentic AI provider (OpenAI-compatible; server-only, never NEXT_PUBLIC_*)
# AI_MODE=auto uses the provider when a key is set; AI_MODE=offline never sends
# visitor text anywhere. The curated offline fallback stays available either way.
AI_MODE=auto
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=free-ai/mistral
AI_TIMEOUT_MS=15000

# Staff authentication and private-message encryption (generated by `npm run setup`)
# Setup writes random values to .env.local; keep them stable and back them up.
ADMIN_PASSWORD=
MESSAGE_ENCRYPTION_KEY=

# Rate limiting (server-only)
# Each signed visitor cookie gets 5 attempts per 10 minutes; the global cap
# limits provider spend. No IP addresses are stored.
SUBMISSION_RATE_LIMIT=5
GLOBAL_RATE_LIMIT=60
